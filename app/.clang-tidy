# clang-tidy configuration for the EinkHome guest app (app/).
#
# Curated to surface real bugs and stylistic regressions in an
# embedded/C codebase without drowning in low-level C noise.  Run with
# -p build/compile_commands.json (see scripts/gen-compile-commands.py).
# Vendored code (app/vendor/cJSON.c) is excluded from the compile DB and
# thus from here.
#
# Disabled-check rationale (kept in this header block: clang-tidy parses
# the Checks scalar verbatim, so `#` comments inside it would break
# every later entry):
#   - bugprone-macro-parentheses: only cJSON.h (vendored) trips it.
#   - bugprone-multi-level-implicit-pointer-conversion: object-level
#     casts through qsort/bsearch/free callbacks are idiomatic C and
#     correct here; -Wall already covers the real abuse.
#   - bugprone-implicit-widening-of-multiplication-result,
#     -bugprone-narrowing-conversions, -bugprone-signed-char-misuse:
#     arithmetic in audio/offset math already promoted by -Wall; pure
#     noise at this scale.
#   - bugprone-suspicious-string-compare, -bugprone-branch-clone,
#     -bugprone-unchecked-string-to-number-conversion: idiomatic C
#     patterns already vetted by the logic; no added signal.
#   - concurrency-mt-unsafe: the app is single-threaded by design (one
#     worker thread + the main loop); readdir/fopen-on-worker is safe.
#   - clang-analyzer-security.insecureAPI.*: snprintf/memcpy are used
#     WITH explicit bounds everywhere; glibc has no snprintf_s.
#   - clang-analyzer-unix.Stream: "stream in EOF state" follows a read
#     loop that already returned; the follow-up is dead code kept for
#     clarity.
#   - clang-analyzer-optin.performance.Padding: embedded struct layout
#     is a deliberate memory tradeoff, not a bug.
#   - readability-redundant-declaration / readability-non-const-parameter:
#     repeated forward declarations and non-const params aren't bugs;
#     keep the gate focused on real defects.
#   - performance-inefficient-vector-operation /
#     performance-no-int-to-ptr: no signal in this codebase.
---
Checks: >
  -*,
  bugprone-*,
  cert-err34-c,
  clang-analyzer-*,
  concurrency-*,
  deadcode-*,
  performance-*,
  portability-*,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-string-compare,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-signed-char-misuse,
  -bugprone-suspicious-string-compare,
  -bugprone-branch-clone,
  -bugprone-unchecked-string-to-number-conversion,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.insecureAPI.strcpy,
  -clang-analyzer-valist.Uninitialized,
  -clang-analyzer-unix.Stream,
  -clang-analyzer-optin.performance.Padding,
  -concurrency-mt-unsafe,
  -readability-redundant-declaration,
  -readability-non-const-parameter,
  -performance-inefficient-vector-operation,
  -performance-no-int-to-ptr
WarningsAsErrors: ''
HeaderFilterRegex: '^.*/app/.*\.h$'
FormatStyle: file