// The long-press context menu (C eh_draw_context): hatch dim over the
// FULL screen + centred white sheet (single border) — no title, a divider
// under the 72px title band, then n 96px action rows (84px boxes).
// ph = 72 + n*96 + 24, centred on the FULL screen (context_geom parity).

import { HatchDim, SheetGeom, SheetPanel } from "sheet.slint";

export component ContextMenu inherits Rectangle {
    in-out property <int> screen-h: 0;
    in-out property <int> w: 0;
    in-out property <int> rows: 0;
    in-out property <[string]> labels: [];
    in-out property <image> hatch;

    callback row-tap(int);
    callback outside;

    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clicked => { root.outside(); }
    }

    HatchDim {
        dim-y0: 0px;
        dim-y1: root.screen-h * 1px;
        hatch: root.hatch;
    }

    property <int> pw: SheetGeom.pw(w);
    property <int> px: SheetGeom.px(w);
    property <int> ph: 72 + rows * 96 + 24;
    property <int> py: Math.max(0, Math.floor((screen-h - ph) / 2));

    SheetPanel {
        sheet-px: px;
        sheet-py: py;
        sheet-pw: pw;
        sheet-ph: ph;
    }

    Rectangle {
        x: (px + 24) * 1px;
        y: (py + 72) * 1px;
        width: (pw - 48) * 1px;
        height: 2px;
        background: #aaaaaa;
    }

    for lbl[idx] in root.labels: Rectangle {
        x: (px + 12) * 1px;
        y: (py + 72 + idx * 96) * 1px;
        width: (pw - 24) * 1px;
        height: 84px;
        background: white;
        border-width: 1px;
        border-color: black;
        Text {
            x: 20px;
            y: 0px;
            height: 28px;
            vertical-alignment: center;
            font-size: 28px;
            color: black;
            text: lbl;
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.row-tap(idx); }
        }
    }
}
