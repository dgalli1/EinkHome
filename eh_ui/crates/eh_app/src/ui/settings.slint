// The Settings screen (C eh_draw_overlay_settings): full-screen white,
// the shared overlay header (back chevron + centred title), one row card
// per settings entry (labels + values come as parallel models from
// Rust; the System-app row only exists on PocketBook-class platforms),
// then the filled Save + outlined Show logs / Licenses buttons.  The
// row owning the on-screen keyboard draws inverted (black card, white
// text).

import { TopBar } from "topbar.slint";

export component SettingsPage inherits Rectangle {
    in-out property <string> title: "";
    in-out property <[string]> card-labels: [];   // translated, Rust-side
    in-out property <int> card-rows: 0;
    in-out property <[string]> card-values: [];   // aligned with labels
    in-out property <int> sysapp-idx: -1;         // -1 = row hidden
    in-out property <bool> sysapp-on: false;
    in-out property <int> editing: -1;   // 0 = api host, 1 = api key
    in-out property <string> save-label: "";
    in-out property <string> logs-label: "";
    in-out property <string> licenses-label: "";
    in-out property <string> reset-label: "";
    in-out property <image> back-icon;
    in-out property <image> back-icon-inv;

    callback back;
    callback row-tap(int);   // 0..n cards, then n..n+3 = Save/logs/licenses/reset

    background: white;

    TopBar {
        y: 0;
        back: true;
        search-tab: true;
        title-bold: true;
        top-title: root.title;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        home => { root.back(); }
    }


    for lbl[idx] in root.card-labels: Rectangle {
        x: 32px;
        y: (112 + idx * 120) * 1px;
        width: parent.width - 64px;
        height: 108px;
        background: root.editing == idx ? black : white;
        border-width: 2px;
        border-color: black;
        Text {
            x: 16px;
            y: 11px;
            height: 28px;
            vertical-alignment: center;
            font-size: 26px;
            font-weight: 700;
            color: root.editing == idx ? white : black;
            text: lbl;
        }
        Text {
            x: 16px;
            y: 50px;
            height: 29px;
            vertical-alignment: center;
            font-size: 30px;
            color: root.editing == idx ? white : black;
            overflow: elide;
            // the system-app card carries the toggle switch on the right
            width: idx == root.sysapp-idx ? parent.width - 176px : parent.width - 32px;
            text: root.card-values[idx];
        }
        if (idx == root.sysapp-idx): Rectangle {
            // the toggle: pill + knob, black when installed
            x: parent.width - 136px;
            y: (parent.height - 52px) / 2;
            width: 104px;
            height: 52px;
            border-radius: 26px;
            background: root.sysapp-on ? black : white;
            border-width: 2px;
            border-color: black;
            animate background { duration: 120ms; }
            Rectangle {
                x: root.sysapp-on ? self.width + 4px : 4px;
                y: 4px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.sysapp-on ? white : black;
                animate x { duration: 120ms; }
            }
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.row-tap(idx); }
        }
    }

    // buttons: filled Save, outlined Show logs + Licenses — placed under
    // the LAST card and numbered relative to the live row count
    property <int> buttons-y: 112 + root.card-rows * 120 + 24;
    for b in [
        {i: 0, label: root.save-label, filled: true},
        {i: 1, label: root.logs-label, filled: false},
        {i: 2, label: root.licenses-label, filled: false},
        {i: 3, label: root.reset-label, filled: false},
    ]: Rectangle {
        x: 32px;
        y: (root.buttons-y + b.i * 96) * 1px;
        width: parent.width - 64px;
        height: 84px;
        background: b.filled ? black : white;
        border-width: 2px;
        border-color: black;
        Text {
            y: 0;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: parent.width;
            font-size: 32px;
            font-weight: 700;
            color: b.filled ? white : black;
            text: b.label;
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.row-tap(root.card-rows + b.i); }
        }
    }
}
