// One book's metadata page (long-press → Details): the cover in large
// (2:3 card, 333×500 at the content's top-left) and every field the store
// carries beside it, as label/value rows.  Back returns to the shelf.

import { TopBar } from "topbar.slint";
import { DetailRow } from "types.slint";

export component BookDetailPage inherits Rectangle {
    in-out property <string> title: "";
    in-out property <[DetailRow]> rows: [];
    in-out property <image> cover;
    in-out property <bool> has-cover: false;
    in-out property <image> back-icon;

    callback back;

    background: white;

    TopBar {
        y: 0;
        back: true;
        search-tab: true;
        back-icon: root.back-icon;
        home => { root.back(); }
    }

    // the cover in large: 2:3 card at 333×500.  Tapping it zooms the
    // image to the whole content area (aspect-fit) — any tap zooms back.
    property <bool> zoom: false;
    if (root.has-cover): TouchArea {
        x: root.zoom ? 0 : 48px;
        y: root.zoom ? 96px : 128px;
        width: root.zoom ? parent.width : 335px;
        height: root.zoom ? parent.height - 96px : 502px;
        clicked => { root.zoom = !root.zoom; }
    }
    Image {
        x: root.zoom ? 0 : 49px;
        y: root.zoom ? 96px : 129px;
        width: root.zoom ? parent.width : 333px;
        height: root.zoom ? parent.height - 96px : 500px;
        source: root.cover;
        visible: root.has-cover;
        image-fit: root.zoom ? ImageFit.contain : ImageFit.fill;
        image-rendering: pixelated;
    }
    Rectangle {
        x: 48px;
        y: 128px;
        width: 335px;
        height: 502px;
        border-width: 1px;
        border-color: black;
        visible: !root.has-cover;
    }

    property <length> rows-x: 429px;
    property <length> rows-w: root.width - rows-x - 48px;

    // Right column: the book title first — wrapped onto as many lines
    // as it needs (elided only past the available height) — then the
    // label/value field rows.
    VerticalLayout {
        x: rows-x;
        y: 128px;
        width: rows-w;
        height: parent.height - 152px;
        spacing: 12px;
        visible: !root.zoom;

        Text {
            text: root.title;
            font-size: 32px;
            font-weight: 700;
            color: black;
            wrap: word-wrap;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-stretch: 0;
        }
        for r in root.rows: Rectangle {
            background: transparent;
            min-height: 88px;
            max-height: 88px;
            vertical-stretch: 0;
            Text {
                x: 0;
                y: 0;
                height: 26px;
                font-size: 22px;
                color: #555555;
                overflow: elide;
                width: parent.width;
                text: r.label;
            }
            Text {
                x: 0;
                y: 30px;
                height: 34px;
                vertical-alignment: center;
                font-size: 28px;
                color: black;
                overflow: elide;
                width: parent.width;
                text: r.value;
            }
        }
        // slack sink: keeps the title at its natural wrapped height and
        // the rows at their fixed pitch instead of stretching either
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
