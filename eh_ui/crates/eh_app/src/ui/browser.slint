// The Folder source's directory browser body (C eh_browser.c
// BR_MODE_BROWSER): full-width 96px rows — ".." ascend, directories with a
// trailing "/", book files plain — each with a light separator.  Rows
// start 8px below the TOP_BAR_H+TOP_BAR_PAD band (body-local 20px), the
// exact origin the C tap handler shares.

import { BrowseRow } from "types.slint";

export component BrowseBody inherits Rectangle {
    in-out property <[BrowseRow]> rows: [];
    in-out property <bool> picker: false;   // download-dir picker: select button
    in-out property <string> select-label: "";
    callback row-tap(int);   // visible row index (0 = first visible)
    callback select;         // "use this folder" (picker mode only)


    for r[idx] in root.rows: Rectangle {
        y: 20px + idx * 96px;
        width: 100%;
        height: 96px;
        background: white;
        Text {
            x: 32px;
            y: 0;
            height: 76px;
            vertical-alignment: center;
            font-size: 28px;
            color: black;
            overflow: elide;
            width: parent.width - 64px;
            text: r.label;
        }
        Rectangle {
            x: 0;
            y: 95px;
            width: 100%;
            height: 1px;
            background: #aaaaaa;
        }
        TouchArea {
            width: 100%;
            height: 100%;
            enabled: !r.blank;
            clicked => { root.row-tap(idx); }
        }
    }

    // picker: the explicit "use this folder" commit button, docked above
    // the pager (navigation alone never commits).
    if (root.picker): Rectangle {
        x: 32px;
        y: root.height - 96px;
        width: root.width - 64px;
        height: 84px;
        background: black;
        border-width: 2px;
        border-color: black;
        Text {
            width: 100%;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 32px;
            font-weight: 700;
            color: white;
            text: root.select-label;
        }
        TouchArea {
            clicked => { root.select(); }
        }
    }
}
