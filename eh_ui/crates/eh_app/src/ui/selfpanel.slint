// The self-drawn status strip (C eh_plat_stamp_panel): a white band below
// the content area with the real clock, the frontlight bulb (baked icon),
// and the battery gauge.  Only shown on devices whose firmware does not
// paint its own panel (needs-self-panel).  Band height: 106px (the C
// eh_plat_panel_height constant).

export component SelfPanel inherits Rectangle {
    background: white;

    in-out property <string> clock: "";
    in-out property <int> battery-level: 0;
    in-out property <bool> frontlight: false;
    in-out property <image> bulb-icon;

    // top separator
    Rectangle {
        y: 0;
        width: 100%;
        height: 2px;
        background: black;
    }

    // clock: C draws 40px with baseline at mid(53) - 12
    Text {
        x: 24px;
        y: 0;
        height: 59px;
        vertical-alignment: center;
        font-size: 40px;
        color: black;
        text: root.clock;
    }

    // frontlight bulb (baked circle + rays), centred at x = w-176
    Image {
        x: root.width - 176px - 24px;
        y: (root.height - 48px) / 2;
        source: root.bulb-icon;
        visible: root.frontlight;
    }

    // battery: 84x40 outline + nub + proportional fill
    property <length> bx: root.width - 116px;
    property <length> by: (106px - 40px) / 2;
    Rectangle {
        x: bx;
        y: by;
        width: 84px;
        height: 40px;
        border-width: 3px;
        border-color: black;
        background: white;
        Rectangle {
            x: 4px;
            y: 4px;
            width: Math.max(0, Math.floor((parent.width - 8px) / 1px * root.battery-level / 100)) * 1px;
            height: parent.height - 8px;
            background: black;
        }
    }
    Rectangle {
        x: bx + 85px;
        y: by + 13px;
        width: 6px;
        height: 14px;
        background: black;
    }
}
