// EinkHome main UI — Slint port of the C app's screen set.
//
// Every geometry constant here mirrors the C app (eh_core.h / eh_topbar.c /
// eh_grid.c) verbatim — the e2e suite taps coordinates computed from the
// same numbers, so they are contract, not style.  Colors are the grayscale
// palette (BLACK 0x00 / DGRAY 0x55 / LGRAY 0xaa / WHITE 0xff); the bridge
// renders through the software renderer into the 8bpp/24bpp/32bpp
// framebuffer.

import { EhOverlay, EhTab, ShelfTile, BrowseRow, DetailRow } from "types.slint";
import { TopBar } from "topbar.slint";
import { ShelfBody } from "shelf.slint";
import { BrowseBody } from "browser.slint";
import { BookDetailPage } from "detail.slint";
import { DetailRow as DetailRowT } from "types.slint";
import { Pager } from "pager.slint";
import { SelfPanel } from "selfpanel.slint";
import { MoreMenu } from "more.slint";
import { SourceSheet } from "source.slint";
import { ChooserSheet } from "chooser.slint";
import { ContextMenu } from "context.slint";
import { DownloadPopup } from "download.slint";
import { SyncSheet } from "syncsheet.slint";
import { OsK } from "osk.slint";
import { SettingsPage } from "settings.slint";
import { LogViewerPage, LicensesListPage, LicenseDetailPage } from "viewer.slint";
import { LauncherPage, LauncherEntry } from "launcher.slint";

export { LauncherEntry }

export { EhOverlay, EhTab, ShelfTile, BrowseRow, DetailRow }

export component EhAppWindow inherits Window {
    background: white;
    default-font-family: "DejaVu Sans";

    // ── app state (synced from Rust before every present) ──────────────
    in-out property <EhOverlay> overlay: EhOverlay.none;
    in-out property <EhTab> tab: EhTab.library;
    in-out property <length> content-bottom: 1448px;
    in-out property <bool> has-self-panel: false;
    in-out property <bool> back: false;        // drilled or search: chevron
    in-out property <string> top-title: "";
    in-out property <string> source-label: "";
    in-out property <int> page: 0;
    in-out property <int> pages: 1;
    in-out property <bool> syncing: false;
    in-out property <int> sync-angle: 0;
    // top-bar icon set + inverted press-feedback twins + spin quadrants
    // (baked at boot; see ui/icons.rs)
    in-out property <image> source-icon-inv;
    in-out property <image> house-icon-inv;
    in-out property <image> back-icon-inv;
    in-out property <image> search-icon-inv;
    in-out property <image> layout-grid-icon-inv;
    in-out property <image> layout-list-icon-inv;
    in-out property <image> sync-icon-inv;
    in-out property <[image]> sync-frames;
    in-out property <[image]> sync-frames-inv;
    in-out property <bool> grid-mode: true;
    in-out property <[ShelfTile]> entries: [];
    // folder browser body (Folder source)
    in-out property <bool> browse-mode: false;
    in-out property <bool> picker-mode: false;  // download-dir picker body
    in-out property <string> picker-select-label: "";
    in-out property <[BrowseRow]> browse-rows: [];
    in-out property <int> browse-scroll: 0;
    // search page
    in-out property <string> query: "";
    in-out property <string> search-placeholder: "";
    in-out property <bool> search-kb: false;
    in-out property <[string]> history: [];
    in-out property <bool> history-hint: false;
    // overlays
    in-out property <[string]> more-labels: [];
    in-out property <string> more-group-value: "";
    in-out property <string> more-sort-value: "";
    in-out property <string> source-title: "";
    in-out property <[string]> source-labels: [];
    in-out property <int> source-selected: 0;
    in-out property <string> chooser-title: "";
    in-out property <string> chooser-current: "";
    in-out property <int> chooser-rows: 0;
    in-out property <int> chooser-selected: -1;
    in-out property <[string]> chooser-labels: [];
    in-out property <[string]> context-labels: [];
    in-out property <int> context-rows: 0;
    in-out property <string> dl-title: "";
    in-out property <string> dl-status: "";
    in-out property <string> sync-title: "";
    in-out property <string> sync-line: "";
    in-out property <string> sync-subline: "";
    in-out property <bool> sync-show-bar: false;
    in-out property <float> sync-bar-fill: 0.0;
    in-out property <string> sync-stripes: "";
    in-out property <string> settings-title: "";
    in-out property <[string]> settings-labels: [];
    in-out property <[string]> settings-values: [];   // aligned with labels
    in-out property <int> settings-card-rows: 0;
    in-out property <int> settings-sysapp-idx: -1;    // -1 = row hidden
    in-out property <bool> settings-sysapp-on: false;
    in-out property <int> settings-editing: -1;
    in-out property <string> settings-save: "";
    in-out property <string> settings-logs: "";
    in-out property <string> settings-licenses: "";
    in-out property <string> settings-reset: "";
    in-out property <string> viewer-path: "";
    in-out property <string> detail-title: "";
    in-out property <[DetailRow]> detail-rows: [];
    in-out property <image> detail-cover;
    in-out property <bool> detail-has-cover: false;
    in-out property <[string]> viewer-rows: [];
    in-out property <bool> viewer-empty: false;
    in-out property <string> viewer-empty-text: "";
    in-out property <string> viewer-title: "";
    in-out property <bool> viewer-up: false;
    in-out property <bool> viewer-down: false;
    in-out property <[string]> lic-names: [];
    in-out property <[string]> lic-kinds: [];
    in-out property <string> lic-attribution: "";
    in-out property <string> launcher-empty: "";
    in-out property <[LauncherEntry]> launcher-items: [];
    in-out property <int> launcher-scroll: 0;
    in-out property <int> launcher-body-h: 0;
    in-out property <bool> launcher-up: false;
    in-out property <bool> launcher-down: false;
    // self panel
    in-out property <string> clock: "";
    in-out property <int> battery-level: 0;
    in-out property <bool> frontlight: false;
    // baked line-art icons (src/ui/icons.rs)
    in-out property <image> house-icon;
    in-out property <image> back-icon;
    in-out property <image> source-icon;
    in-out property <image> chevron;
    in-out property <image> chevron-down;
    in-out property <image> search-icon;
    in-out property <image> layout-grid-icon;
    in-out property <image> layout-list-icon;
    in-out property <image> sync-icon;
    in-out property <image> input-icon;
    in-out property <image> input-icon-inv;
    in-out property <image> bulb-icon;
    in-out property <bool> osk-visible: false;
    in-out property <string> kb-title: "";
    in-out property <string> kb-text: "";

    // ── intents (pushed onto the bridge's action queue) ────────────────
    callback home;
    callback source-btn;
    callback search;
    callback layout;
    callback sync;
    callback menu;
    callback pager(int);          // 0=prev 1=first 2=last 3=next
    callback tile(int, bool);     // index, press(true)/release(false)
    callback system-bar;
    callback search-input;
    callback history-row(int);
    callback search-outside;
    callback browse-row(int);     // absolute row index (scroll + visible)
    callback more-row(int);
    callback more-outside;
    callback source-row(int);
    callback source-outside;
    callback chooser-row(int);
    callback chooser-outside;
    callback context-row(int);
    callback context-outside;
    callback dl-cancel;
    callback dl-dismiss;
    callback sync-dismiss;
    callback settings-back;
    callback settings-row(int);
    callback viewer-back;
    callback detail-back;
    callback viewer-scroll(int);
    callback lic-row(int);
    callback launcher-back;
    callback launcher-page(int);
    callback osk-key(string);
    callback osk-back;
    callback osk-ok;
    callback osk-cancel;
    callback launcher-cell(int);
    callback picker-select;


    // ── grid geometry (C eh_grid.c, mirrored exactly) ──────────────────
    property <length> avail-w: self.width - 16px;
    property <length> g-bot: content-bottom - 96px;
    property <length> g-avail-h: g-bot - 96px - 12px - 8px;
    property <int> g-cols: avail-w >= 1360px ? 4 : (avail-w >= 840px ? 3 : 2);
    property <int> g-rows: g-avail-h >= 1400px ? 3 : 2;
    property <length> cell-w: Math.min(Math.max(avail-w / g-cols, 280px), 420px);
    property <length> cell-h: Math.min(Math.max(g-avail-h / g-rows, 280px), 600px);
    property <length> grid-x0: 8px + Math.max(0px, (avail-w - g-cols * cell-w) / 2);

    // Touch catcher for the system strip band (below the content area):
    // any tap there hands control to the firmware panel.
    TouchArea {
        y: content-bottom;
        height: root.height - content-bottom;
        width: 100%;
        enabled: root.has-self-panel;
        clicked => { root.system-bar(); }
    }

    // ── chrome ──────────────────────────────────────────────────────────
    TopBar {
        y: 0;
        width: 100%;
        height: 96px;
        back: root.back;
        top-title: root.top-title;
        source-label: root.source-label;
        source-icon: root.source-icon;
        syncing: root.syncing;
        browse-mode: root.browse-mode;
        sync-angle: root.sync-angle;
        search-tab: root.tab == EhTab.search;
        grid-mode: root.grid-mode;
        house-icon: root.house-icon;
        back-icon: root.back-icon;
        search-icon: root.search-icon;
        layout-grid-icon: root.layout-grid-icon;
        layout-list-icon: root.layout-list-icon;
        sync-icon: root.sync-icon;
        source-icon-inv: root.source-icon-inv;
        house-icon-inv: root.house-icon-inv;
        back-icon-inv: root.back-icon-inv;
        search-icon-inv: root.search-icon-inv;
        layout-grid-icon-inv: root.layout-grid-icon-inv;
        layout-list-icon-inv: root.layout-list-icon-inv;
        sync-icon-inv: root.sync-icon-inv;
        sync-frames: root.sync-frames;
        sync-frames-inv: root.sync-frames-inv;
        home => { root.home(); }
        source-btn => { root.source-btn(); }
        search => { root.search(); }
        layout => { root.layout(); }
        sync => { root.sync(); }
        menu => { root.menu(); }
    }

    // ── body: folder browser OR library shelf / search ─────────────────
    if (root.browse-mode): BrowseBody {
        y: 96px;
        width: root.width;
        height: g-bot - 96px;
        rows: root.browse-rows;
        picker: root.picker-mode;
        select-label: root.picker-select-label;
        row-tap(i) => { root.browse-row(i + root.browse-scroll); }
        select => { root.picker-select(); }
    }
    if (!root.browse-mode): ShelfBody {
        y: 96px;
        width: root.width;
        height: g-bot - 96px;
        entries: root.entries;
        grid-mode: root.grid-mode;
        cell-w: root.cell-w;
        cell-h: root.cell-h;
        grid-x0: root.grid-x0;
        g-cols: root.g-cols;
        query: root.query;
        search-placeholder: root.search-placeholder;
        search-kb: root.search-kb;
        kb-text: root.kb-text;
        history: root.history;
        history-hint: root.history-hint;
        search-tab: root.tab == EhTab.search;
        input-icon: root.input-icon;
        input-icon-inv: root.input-icon-inv;
        tile(i, down) => { root.tile(i, down); }
        search-input => { root.search-input(); }
        history-row(i) => { root.history-row(i); }
        outside => { root.search-outside(); }
    }

    Pager {
        y: g-bot;
        width: 100%;
        height: 96px;
        page: root.page;
        pages: root.pages;
        pager(a) => { root.pager(a); }
    }

    SelfPanel {
        y: content-bottom;
        width: 100%;
        height: root.height - content-bottom;
        clock: root.clock;
        battery-level: root.battery-level;
        frontlight: root.frontlight;
        bulb-icon: root.bulb-icon;
        visible: root.has-self-panel;
    }

    // ── overlays (one deep, C overlay enum semantics) ───────────────────
    if (root.overlay == EhOverlay.more): MoreMenu {
        content-h: Math.floor(root.content-bottom / 1px);
        w: Math.floor(root.width / 1px);
        group-value: root.more-group-value;
        sort-value: root.more-sort-value;
        labels: root.more-labels;
        row-tap(i) => { root.more-row(i); }
        outside => { root.more-outside(); }
    }
    if (root.overlay == EhOverlay.source): SourceSheet {
        content-h: Math.floor(root.content-bottom / 1px);
        w: Math.floor(root.width / 1px);
        selected: root.source-selected;
        title: root.source-title;
        labels: root.source-labels;
        row-tap(i) => { root.source-row(i); }
        outside => { root.source-outside(); }
    }
    if (root.overlay == EhOverlay.group-chooser
        || root.overlay == EhOverlay.sort-chooser): ChooserSheet {
        content-h: Math.floor(root.content-bottom / 1px);
        w: Math.floor(root.width / 1px);
        rows: root.chooser-rows;
        selected: root.chooser-selected;
        title: root.chooser-title;
        current: root.chooser-current;
        labels: root.chooser-labels;
        row-tap(i) => { root.chooser-row(i); }
        outside => { root.chooser-outside(); }
    }
    if (root.overlay == EhOverlay.context): ContextMenu {
        screen-h: Math.floor(root.height / 1px);
        w: Math.floor(root.width / 1px);
        rows: root.context-rows;
        labels: root.context-labels;
        row-tap(i) => { root.context-row(i); }
        outside => { root.context-outside(); }
    }
    if (root.overlay == EhOverlay.download): DownloadPopup {
        content-h: Math.floor(root.content-bottom / 1px);
        w: Math.floor(root.width / 1px);
        title: root.dl-title;
        status: root.dl-status;
        cancel => { root.dl-cancel(); }
        dismiss => { root.dl-dismiss(); }
    }
    if (root.overlay == EhOverlay.settings): SettingsPage {
        width: root.width;
        height: root.height;
        title: root.settings-title;
        card-labels: root.settings-labels;
        card-values: root.settings-values;
        card-rows: root.settings-card-rows;
        sysapp-idx: root.settings-sysapp-idx;
        sysapp-on: root.settings-sysapp-on;
        editing: root.settings-editing;
        save-label: root.settings-save;
        logs-label: root.settings-logs;
        licenses-label: root.settings-licenses;
        reset-label: root.settings-reset;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.settings-back(); }
        row-tap(i) => { root.settings-row(i); }
    }
    if (root.overlay == EhOverlay.detail): BookDetailPage {
        width: root.width;
        height: root.height;
        title: root.detail-title;
        rows: root.detail-rows;
        cover: root.detail-cover;
        has-cover: root.detail-has-cover;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.detail-back(); }
    }
    if (root.overlay == EhOverlay.log-viewer): LogViewerPage {
        width: root.width;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        height: root.height;
        title: root.viewer-title;
        path-line: root.viewer-path;
        rows: root.viewer-rows;
        empty: root.viewer-empty;
        empty-text: root.viewer-empty-text;
        up-ok: root.viewer-up;
        down-ok: root.viewer-down;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.viewer-back(); }
        scroll(d) => { root.viewer-scroll(d); }
    }
    if (root.overlay == EhOverlay.licenses): LicensesListPage {
        width: root.width;
        height: root.height;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        title: root.viewer-title;
        names: root.lic-names;
        kinds: root.lic-kinds;
        up-ok: root.viewer-up;
        down-ok: root.viewer-down;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.viewer-back(); }
        scroll(d) => { root.viewer-scroll(d); }
        row-tap(i) => { root.lic-row(i); }
    }
    if (root.overlay == EhOverlay.license-detail): LicenseDetailPage {
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        width: root.width;
        height: root.height;
        title: root.viewer-title;
        attribution: root.lic-attribution;
        rows: root.viewer-rows;
        up-ok: root.viewer-up;
        down-ok: root.viewer-down;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.viewer-back(); }
        scroll(d) => { root.viewer-scroll(d); }
    }
    if (root.overlay == EhOverlay.launcher): LauncherPage {
        width: root.width;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        height: root.height;
        title: root.viewer-title;
        empty: root.launcher-items.length == 0;
        empty-text: root.launcher-empty;
        items: root.launcher-items;
        scroll: root.launcher-scroll;
        body-h: root.launcher-body-h;
        up-ok: root.launcher-up;
        down-ok: root.launcher-down;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        back => { root.launcher-back(); }
        scroll-page(d) => { root.launcher-page(d); }
        cell(i) => { root.launcher-cell(i); }
    }
    if (root.overlay == EhOverlay.sync): SyncSheet {
        content-h: Math.floor(root.content-bottom / 1px);
        w: Math.floor(root.width / 1px);
        title: root.sync-title;
        line: root.sync-line;
        subline: root.sync-subline;
        show-bar: root.sync-show-bar;
        bar-fill: root.sync-bar-fill;
        stripe-path: root.sync-stripes;
        dismiss => { root.sync-dismiss(); }
    }
    if (root.osk-visible): OsK {
        y: root.content-bottom - self.height;
        width: 100%;
        content-h: Math.floor(root.content-bottom / 1px);
        title: root.kb-title;
        text: root.kb-text;
        key(k) => { root.osk-key(k); }
        back => { root.osk-back(); }
        commit => { root.osk-ok(); }
        cancel => { root.osk-cancel(); }
    }
}
