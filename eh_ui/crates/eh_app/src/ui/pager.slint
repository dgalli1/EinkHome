// The pager band (C eh_draw_pager verbatim): 2px top border, centered
// "N / M", four 96x64 bordered buttons — "<" prev, "<<" first, ">>" last,
// ">" next — disabled ones with a greyed label.

component PagerButton inherits Rectangle {
    width: 96px;
    height: 64px;
    y: 16px;
    border-width: 2px;
    border-color: black;
    background: white;

    in-out property <string> label: "";
    in-out property <bool> enabled: true;
    in-out property <int> action: 0;
    callback pager(int);

    TouchArea {
            width: 100%;
            height: 100%;
        clicked => { root.pager(root.action); }
    }
    Text {
        y: 0;
        height: parent.height;
        width: parent.width;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-size: 28px;
        color: root.enabled ? black : #aaaaaa;
        text: root.label;
    }
}

export component Pager inherits Rectangle {
    background: white;

    in-out property <int> page: 0;
    in-out property <int> pages: 1;
    callback pager(int);

    // top border
    Rectangle {
        y: 0;
        width: 100%;
        height: 2px;
        background: black;
    }

    Text {
        y: 16px;
        height: 64px;
        x: (parent.width - self.preferred-width) / 2;
        vertical-alignment: center;
        font-size: 30px;
        color: black;
        text: (root.page + 1) + " / " + Math.max(root.pages, 1);
    }

    PagerButton {
        x: 12px;
        label: "<";
        enabled: root.page > 0;
        action: 0;
        pager(a) => { root.pager(a); }
    }
    PagerButton {
        x: 116px;
        label: "<<";
        enabled: root.page > 0;
        action: 1;
        pager(a) => { root.pager(a); }
    }
    PagerButton {
        x: parent.width - 212px;
        label: ">>";
        enabled: root.page + 1 < root.pages;
        action: 2;
        pager(a) => { root.pager(a); }
    }
    PagerButton {
        x: parent.width - 108px;
        label: ">";
        enabled: root.page + 1 < root.pages;
        action: 3;
        pager(a) => { root.pager(a); }
    }
}
