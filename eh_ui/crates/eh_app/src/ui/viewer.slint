// The full-screen viewers (C eh_logview.c / eh_licenses.c): the log tail
// (word-wrapped Rust-side with the same fontdue metrics as before — the
// model carries exactly the visible rows), the licenses list, and the
// license detail.  Corner scroll buttons page the body; Back steps
// detail → list → shelf.

import { TopBar } from "topbar.slint";

// Corner scroll button (C eh_draw_scroll_buttons_at): 150x96 box, 2px
// border (grey when disabled), a baked chevron pointing up (left) or
// down (rotated 180°).  The old vector Path drew as an empty box — the
// software renderer does not rasterise Path.
export component ScrollButton inherits Rectangle {
    width: 150px;
    height: 96px;
    in-out property <bool> up: true;
    in-out property <bool> enabled-dir: true;
    in-out property <image> chevron;
    in-out property <image> chevron-down;
    callback scroll(int);

    background: white;
    border-width: 2px;
    border-color: enabled-dir ? black : #aaaaaa;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.up ? root.chevron : root.chevron-down;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.scroll(root.up ? -1 : 1); }
    }
}

component LogRows inherits Rectangle {
    in-out property <[string]> rows: [];
    in-out property <length> body-top: 0px;
    // No explicit height: the Text sizes itself to the font's natural
    // line box — a fixed 22px box clipped every glyph's top (the
    // "unreadable log" bug).  The 34px pitch clears the 26px ink.
    for t[idx] in root.rows: Text {
        y: root.body-top + idx * 34px;
        x: 16px;
        width: parent.width - 32px;
        font-size: 26px;
        color: black;
        overflow: clip;
        text: t;
    }
}

export component LogViewerPage inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> path-line: "";
    in-out property <[string]> rows: [];
    in-out property <bool> empty: false;
    in-out property <string> empty-text: "";
    in-out property <bool> up-ok: false;
    in-out property <bool> down-ok: false;
    in-out property <image> back-icon;
    in-out property <image> back-icon-inv;
    in-out property <image> chevron;
    in-out property <image> chevron-down;

    callback back;
    callback scroll(int);

    background: white;

    TopBar {
        y: 0;
        back: true;
        search-tab: true;
        title-bold: true;
        top-title: root.title;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        home => { root.back(); }
    }
    // the log path in its own band below the header rule
    Text {
        y: 96px + 6px;
        height: 30px;
        width: parent.width;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 26px;
        color: #555555;
        overflow: elide;
        text: root.path-line;
    }

    if (root.empty): Text {
        x: 32px;
        y: 138px + 27px;
        height: 30px;
        vertical-alignment: center;
        font-size: 26px;
        color: #555555;
        text: root.empty-text;
    }
    if (!root.empty): LogRows {
        y: 0;
        rows: root.rows;
        body-top: 138px;
    }

    ScrollButton {
        x: 0;
        y: parent.height - 96px;
        up: true;
        enabled-dir: root.up-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
    ScrollButton {
        x: parent.width - 150px;
        y: parent.height - 96px;
        up: false;
        enabled-dir: root.down-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
}

export component LicensesListPage inherits Rectangle {
    in-out property <string> title: "";
    in-out property <[string]> names: [];   // visible rows: "name" (kind in sub)
    in-out property <[string]> kinds: [];
    in-out property <bool> up-ok: false;
    in-out property <bool> down-ok: false;
    in-out property <image> back-icon;
    in-out property <image> back-icon-inv;
    in-out property <image> chevron;
    in-out property <image> chevron-down;

    callback back;
    callback scroll(int);
    callback row-tap(int);

    background: white;

    TopBar {
        y: 0;
        back: true;
        search-tab: true;
        title-bold: true;
        top-title: root.title;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        home => { root.back(); }
    }

    for nm[idx] in root.names: Rectangle {
        x: 16px;
        y: (112 + idx * 110) * 1px;
        width: parent.width - 32px;
        height: 98px;
        background: white;
        border-width: 2px;
        border-color: black;
        Text {
            x: 16px;
            y: 13px;
            height: 35px;
            vertical-alignment: center;
            font-size: 30px;
            color: black;
            overflow: elide;
            width: parent.width - 32px;
            text: nm;
        }
        Text {
            x: 16px;
            y: 49px;
            height: 28px;
            vertical-alignment: center;
            font-size: 24px;
            color: #555555;
            overflow: elide;
            width: parent.width - 32px;
            text: root.kinds[idx];
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.row-tap(idx); }
        }
    }

    ScrollButton {
        x: 0;
        y: parent.height - 96px;
        up: true;
        enabled-dir: root.up-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
    ScrollButton {
        x: parent.width - 150px;
        y: parent.height - 96px;
        up: false;
        enabled-dir: root.down-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
}

export component LicenseDetailPage inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> attribution: "";
    in-out property <[string]> rows: [];
    in-out property <bool> up-ok: false;
    in-out property <bool> down-ok: false;
    in-out property <image> back-icon;
    in-out property <image> back-icon-inv;
    in-out property <image> chevron;
    in-out property <image> chevron-down;

    callback back;
    callback scroll(int);

    background: white;

    TopBar {
        y: 0;
        back: true;
        search-tab: true;
        title-bold: true;
        top-title: root.title;
        back-icon: root.back-icon;
        back-icon-inv: root.back-icon-inv;
        home => { root.back(); }
    }

    // attribution band: flush left like the body rows (was centred, which
    // read as the first line starting mid-line)
    Text {
        x: 16px;
        y: 96px + 6px;
        height: 30px;
        width: parent.width - 32px;
        vertical-alignment: center;
        font-size: 26px;
        color: #555555;
        overflow: elide;
        text: root.attribution;
    }

    LogRows {
        y: 0;
        rows: root.rows;
        body-top: 138px;
    }

    ScrollButton {
        x: 0;
        y: parent.height - 96px;
        up: true;
        enabled-dir: root.up-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
    ScrollButton {
        x: parent.width - 150px;
        y: parent.height - 96px;
        up: false;
        enabled-dir: root.down-ok;
        chevron: root.chevron;
        chevron-down: root.chevron-down;
        scroll(d) => { root.scroll(d); }
    }
}
