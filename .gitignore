build/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.coverage.*
# Local API config (may hold provider credentials) + caches.
# server-100k.json is safe to share (no secrets) and REQUIRED by the
# scale test suite, so it stays tracked.
api/config/*
!api/config/server-100k.json
!api/config/server.json.example
api/.cover-cache/
# Emulator cover cache / mock corpus (regenerated by the test suite)
.cover-cache/
# Coding-agent harness state
.omp/
# PocketBook SDK blob (re-fetched via sdk/install-sdk.sh)
sdk/pocketbook-sdk-b288/
# Screenshots from scripts/click_first_book.py
screenshots/
firmwares/
tmp/

# Rust native lib (eh_lib) build artifacts
eh_lib/target/

# Device screenshots (scp'd off a PocketBook via ssh)
scr*.bmp
scr*.png
covers/

# Desktop-run runtime state at the repo root (regenerated every run)
/bookshelf.cfg
/bookshelf.log
/bookshelf_lib.db
